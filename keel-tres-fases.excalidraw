      "type": "text",
      "x": 70,
      "y": 2272,
      "width": 1200,
      "height": 20,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "strokeWidth": 2,
      "text": "Ninguno es un problema de Java ni de Spring: son los problemas de construir software con agentes. El stack solo decide qué generador se usa.",
      "originalText": "Ninguno es un problema de Java ni de Spring: son los problemas de construir software con agentes. El stack solo decide qué generador se usa.",
      "fontSize": 16,
      "fontFamily": 2,
