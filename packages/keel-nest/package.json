{
  "name": "keel-nest",
  "version": "0.0.1",
  "description": "Generador NestJS para diseños Keel: valida el diseño agnóstico y genera services/<servicio>-nest/ con el scaffolding transversal al stack. Equivalente a keel-spring: el mismo diseño produce servidores con el mismo contrato observable.",
  "type": "module",
  "bin": {
    "keel-nest": "src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "ts-check": "node scripts/ts-check.js",
    "db-check": "node scripts/db-check.js",
    "doc-check": "node scripts/doc-check.js",
    "matrix": "node scripts/support-matrix.js",
    "harness-check": "node scripts/harness-check.js",
    "doc-harness-check": "node scripts/doc-harness-check.js",
    "security-check": "node scripts/security-check.js",
    "broker-check": "node scripts/broker-check.js",
    "stub-check": "node scripts/stub-check.js",
    "mail-check": "node scripts/mail-check.js",
    "cache-check": "node scripts/cache-check.js"
  },
  "files": [
    "src",
    "assets"
  ],
  "keel": {
    "dsl": "2.20"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "keel",
    "nestjs",
    "codegen",
    "agents",
    "dsl"
  ],
  "author": "asuridev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keel-system/keel.git",
    "directory": "packages/keel-nest"
  },
  "homepage": "https://github.com/keel-system/keel/tree/main/packages/keel-nest#readme",
  "bugs": {
    "url": "https://github.com/keel-system/keel/issues"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "keel-core": "^0.4.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@fastify/multipart": "^10.1.1",
    "@redis/client": "^6.2.1",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.5",
    "handlebars": "^4.7.10",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.16",
    "typescript": "~6.0.2"
  }
}
